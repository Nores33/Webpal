+ * linux/include/asm-arm/arch-webpal/uncompress.h
+ *
+ */
+
+/* Webpal bootstrap has a "putc routine located in flash at location 0x20 */
+/* We use this for outputting message to either serial or video during
+   zImage decompress */
+   
+void (*putc)() = (void *)0x20;
+
+/*
+ * This does not append a newline
+ */
+static void puts(const char *s)
+{
+	while (*s) {
+		putc(*s);
+		if (*s == '\n')
+			putc('\r');
+		s++;
+	}
+}
