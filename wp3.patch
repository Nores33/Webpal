+int number(const char *ptr) {
+  int i, j = 1, ret = 0;
+        
+  for (i = 0; i < 8; i++) {
+    if (*ptr >> i & 0x01)
+      ret += j;
+
+    j *= 2;
+  }
+  
+  return ret;
+} /* number() */
